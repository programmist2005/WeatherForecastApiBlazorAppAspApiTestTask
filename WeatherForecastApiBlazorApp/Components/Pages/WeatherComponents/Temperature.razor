@inject UnitSettingsService UnitSettings
@implements IDisposable
@using WeatherForecastApiBlazorApp.Services

<span class="temperature">
	@FormatTemp(Celsius, Fahrenheit)
</span>

@code {
	[Parameter]
	public decimal Celsius { get; set; }
	[Parameter]
	public decimal Fahrenheit { get; set; }

	private string FormatTemp(decimal celsius, decimal fahrenheit)
		=> UnitSettings.UseCelsius ? $"{celsius:0.#}°C" : $"{fahrenheit:0.#}°F";

	protected override void OnInitialized()
	{
		UnitSettings.OnChanged += StateHasChanged;
	}

	public void Dispose()
	{
		UnitSettings.OnChanged -= StateHasChanged;
	}
}
