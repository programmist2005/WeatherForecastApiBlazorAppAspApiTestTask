@page "/weather"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject WeatherService WeatherService

@using WeatherForecastApiBlazorApp.Services
@using WeatherForecastApiBlazorApp.Models
@using WeatherForecastApiBlazorApp.Components.Pages.WeatherComponents

<PageTitle>Погода</PageTitle>

<Settings />

@if (isLoading)
{
	<Loader />
}
else if (errorMessage is not null)
{
	<ErrorLoad ErrorMessage="errorMessage" OnRetry="LoadWeatherAsync" />
}
else if (weather is not null)
{
	<WeatherData Weather="weather" />
}

@code {
	private bool isLoading = true;
	private string? errorMessage;
	private WeatherQueryResult? weather;
	private bool useCelsius = true;
	private bool useKph = true;

	protected override async Task OnInitializedAsync()
	{
		await LoadWeatherAsync();
	}

	private async Task LoadWeatherAsync()
	{
		isLoading = true;
		errorMessage = null;
		weather = null;

		try
		{
			//await Task.Delay(500);
			weather = await WeatherService.GetWeatherAsync();
		}
		catch (ApplicationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (Exception)
		{
			errorMessage = "Произошла непредвиденная ошибка";
		}
		finally
		{
			isLoading = false;
		}
	}
}